import React, { useState, useRef } from 'react';
import { Camera, Mic, Plus, ShoppingCart, CheckCircle, AlertCircle, Target, Utensils, BarChart3, User, Loader2, X } from 'lucide-react';

const MacrolyFit = () => {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [analysisResult, setAnalysisResult] = useState(null);
  const [showLogModal, setShowLogModal] = useState(false);
  const [isRecording, setIsRecording] = useState(false);
  const fileInputRef = useRef(null);
  const mediaRecorderRef = useRef(null);

  const PHOTO_WEBHOOK_URL = 'https://billbotprocessing.app.n8n.cloud/webhook/analyze-photo';
  const VOICE_WEBHOOK_URL = 'https://billbotprocessing.app.n8n.cloud/webhook/analyze-food-voice';

  const userProfile = {
    name: "Alex",
    goal: "Fat Loss",
    age: 32,
    height: "5'10\"",
    dailyTargets: { protein: 180, carbs: 150, fats: 60, calories: 1980 }
  };

  const weeklyPlan = [{
    day: "Monday",
    meals: [
      { id: 1, name: "Greek Yogurt Power Bowl", type: "Breakfast", protein: 35, carbs: 42, fats: 12, calories: 398, prepTime: "5 min" },
      { id: 2, name: "Grilled Chicken & Quinoa", type: "Lunch", protein: 48, carbs: 45, fats: 18, calories: 518, prepTime: "25 min" },
      { id: 3, name: "Salmon with Vegetables", type: "Dinner", protein: 42, carbs: 38, fats: 22, calories: 506, prepTime: "30 min" }
    ],
    totals: { protein: 125, carbs: 125, fats: 52, calories: 1422 }
  }];

  const progressData = {
    currentWeight: 185.2,
    startWeight: 192.0,
    targetWeight: 175,
    adherence: 87,
    weekStreak: 3
  };

  const groceryList = [
    { category: "Protein", items: ["Chicken breast (2 lbs)", "Salmon (1 lb)", "Greek yogurt (32 oz)", "Eggs (1 dozen)"] },
    { category: "Produce", items: ["Broccoli", "Sweet potatoes", "Mixed greens", "Bananas"] },
    { category: "Grains", items: ["Quinoa", "Oats", "Brown rice"] }
  ];

  const analyzePhoto = async (file) => {
    setIsAnalyzing(true);
    setShowLogModal(true);
    try {
      const formData = new FormData();
      formData.append('image', file);
      const response = await fetch(PHOTO_WEBHOOK_URL, { method: 'POST', body: formData });
      if (!response.ok) throw new Error('Analysis failed');
      setAnalysisResult(await response.json());
    } catch (error) {
      setAnalysisResult({ error: true, message: 'Failed to analyze image. Please try again.' });
    } finally {
      setIsAnalyzing(false);
    }
  };

  const analyzeVoice = async (audioBlob) => {
    setIsAnalyzing(true);
    setShowLogModal(true);
    try {
      const formData = new FormData();
      formData.append('audio', audioBlob, 'voice-log.webm');
      const response = await fetch(VOICE_WEBHOOK_URL, { method: 'POST', body: formData });
      if (!response.ok) throw new Error('Analysis failed');
      setAnalysisResult(await response.json());
    } catch (error) {
      setAnalysisResult({ error: true, message: 'Failed to process voice input.' });
    } finally {
      setIsAnalyzing(false);
    }
  };

  const handlePhotoClick = () => fileInputRef.current?.click();
  const handlePhotoChange = (e) => { 
    const file = e.target.files?.[0]; 
    if (file) analyzePhoto(file); 
  };

  const handleVoiceClick = async () => {
    if (isRecording) {
      mediaRecorderRef.current?.stop();
      setIsRecording(false);
    } else {
      setShowLogModal(true);
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mediaRecorder = new MediaRecorder(stream);
        const audioChunks = [];
        mediaRecorder.ondataavailable = (e) => audioChunks.push(e.data);
        mediaRecorder.onstop = () => {
          analyzeVoice(new Blob(audioChunks, { type: 'audio/webm' }));
          stream.getTracks().forEach(t => t.stop());
        };
        mediaRecorder.start();
        mediaRecorderRef.current = mediaRecorder;
        setIsRecording(true);
      } catch (error) {
        setAnalysisResult({ error: true, message: 'Unable to access microphone.' });
      }
    }
  };

  const closeModal = () => {
    setShowLogModal(false);
    setAnalysisResult(null);
    setIsAnalyzing(false);
    if (isRecording) {
      mediaRecorderRef.current?.stop();
      setIsRecording(false);
    }
  };

  const MacroBar = ({ protein, carbs, fats, targets }) => {
    const total = protein + carbs + fats;
    const pPct = (protein / total) * 100;
    const cPct = (carbs / total) * 100;
    const fPct = (fats / total) * 100;

    return (
      <div className="w-full">
        <div className="flex h-3 rounded-full overflow-hidden bg-gray-200">
          <div style={{ width: `${pPct}%` }} className="bg-blue-500"></div>
          <div style={{ width: `${cPct}%` }} className="bg-green-500"></div>
          <div style={{ width: `${fPct}%` }} className="bg-yellow-500"></div>
        </div>
        <div className="flex justify-between mt-2 text-xs text-gray-600">
          <span>P: {protein}g / {targets.protein}g</span>
          <span>C: {carbs}g / {targets.carbs}g</span>
          <span>F: {fats}g / {targets.fats}g</span>
        </div>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-gray-50">
      <header className="bg-white border-b border-gray-200 sticky top-0 z-10">
        <div className="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Target className="w-8 h-8 text-blue-600" />
            <h1 className="text-2xl font-bold text-gray-900">Macroly Fit</h1>
          </div>
        </div>
      </header>

      <main className="max-w-4xl mx-auto px-4 py-6 pb-24">
        {activeTab === 'dashboard' && (
          <div className="space-y-6">
            <div className="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h2 className="text-2xl font-bold">Welcome back, {userProfile.name}!</h2>
                  <p className="text-blue-100">Goal: {userProfile.goal}</p>
                </div>
                <div className="text-right">
                  <div className="text-3xl font-bold">{progressData.currentWeight} lbs</div>
                  <div className="text-sm text-blue-100">-{(progressData.startWeight - progressData.currentWeight).toFixed(1)} lbs</div>
                </div>
              </div>
              <div className="grid grid-cols-3 gap-4">
                <div className="bg-white/20 rounded-lg p-3">
                  <div className="text-sm text-blue-100">Weekly %</div>
                  <div className="text-2xl font-bold">{progressData.adherence}%</div>
                </div>
                <div className="bg-white/20 rounded-lg p-3">
                  <div className="text-sm text-blue-100">Week Streak</div>
                  <div className="text-2xl font-bold">{progressData.weekStreak}</div>
                </div>
                <div className="bg-white/20 rounded-lg p-3">
                  <div className="text-sm text-blue-100">Goal</div>
                  <div className="text-2xl font-bold">{(progressData.currentWeight - progressData.targetWeight).toFixed(1)}</div>
                </div>
              </div>
            </div>

            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h3 className="text-xl font-bold text-gray-900 mb-4">Today's Meal Plan</h3>
              <MacroBar protein={weeklyPlan[0].totals.protein} carbs={weeklyPlan[0].totals.carbs} fats={weeklyPlan[0].totals.fats} targets={userProfile.dailyTargets} />
              <div className="mt-6 space-y-3">
                {weeklyPlan[0].meals.map(meal => (
                  <div key={meal.id} className="border border-gray-200 rounded-lg p-4">
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <span className="text-xs font-semibold text-gray-500 uppercase">{meal.type}</span>
                        <h4 className="font-semibold text-gray-900">{meal.name}</h4>
                        <p className="text-sm text-gray-600">⏱ {meal.prepTime}</p>
                      </div>
                      <div className="text-right">
                        <div className="text-sm font-medium text-gray-900">{meal.calories} cal</div>
                        <div className="text-xs text-gray-600">P: {meal.protein}g | C: {meal.carbs}g | F: {meal.fats}g</div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              <button onClick={() => setActiveTab('grocery')} className="w-full mt-4 bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 flex items-center justify-center gap-2">
                <ShoppingCart className="w-5 h-5" />
                Build Grocery List
              </button>
            </div>

            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h3 className="text-xl font-bold text-gray-900 mb-4">Quick Log</h3>
              <div className="grid grid-cols-3 gap-3">
                <input ref={fileInputRef} type="file" accept="image/*" capture="environment" onChange={handlePhotoChange} className="hidden" />
                <button onClick={handlePhotoClick} className="flex flex-col items-center gap-2 p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-400">
                  <Camera className="w-8 h-8 text-gray-600" />
                  <span className="text-sm font-medium">Photo</span>
                </button>
                <button onClick={handleVoiceClick} className={`flex flex-col items-center gap-2 p-4 border-2 border-dashed rounded-lg ${isRecording ? 'border-red-400 bg-red-50' : 'border-gray-300'}`}>
                  <Mic className={`w-8 h-8 ${isRecording ? 'text-red-600 animate-pulse' : 'text-gray-600'}`} />
                  <span className="text-sm font-medium">{isRecording ? 'Recording...' : 'Voice'}</span>
                </button>
                <button onClick={() => setShowLogModal(true)} className="flex flex-col items-center gap-2 p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-400">
                  <Plus className="w-8 h-8 text-gray-600" />
                  <span className="text-sm font-medium">Manual</span>
                </button>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'grocery' && (
          <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 className="text-xl font-bold text-gray-900 mb-6">Weekly Grocery List</h3>
            {groceryList.map((section, idx) => (
              <div key={idx} className="mb-6">
                <h4 className="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  {section.category}
                  <CheckCircle className="w-4 h-4 text-green-500" />
                </h4>
                <ul className="space-y-2">
                  {section.items.map((item, i) => (
                    <li key={i} className="flex items-center gap-3">
                      <input type="checkbox" className="w-4 h-4" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div className="mt-6 pt-6 border-t space-y-3">
              <button className="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 flex items-center justify-center gap-2">
                <ShoppingCart className="w-5 h-5" />
                Send to Instacart
              </button>
            </div>
          </div>
        )}

        {activeTab === 'progress' && (
          <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 className="text-xl font-bold text-gray-900 mb-4">Weight Trend</h3>
            <div className="h-64 flex items-end justify-around border-b border-l border-gray-300 pb-2">
              {[192, 190.5, 189, 188.2, 187, 186.5, 185.2].map((weight, i) => (
                <div key={i} className="flex flex-col items-center gap-2 flex-1">
                  <div className="w-full bg-blue-500 rounded-t" style={{ height: `${((weight - 175) / 17) * 100}%` }}></div>
                  <span className="text-xs">W{i + 1}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {activeTab === 'profile' && (
          <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 className="text-xl font-bold text-gray-900 mb-6">Profile Settings</h3>
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Name</label>
                <input type="text" defaultValue={userProfile.name} className="w-full border border-gray-300 rounded-lg px-4 py-2" />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Goal</label>
                <select defaultValue={userProfile.goal} className="w-full border border-gray-300 rounded-lg px-4 py-2">
                  <option>Fat Loss</option>
                  <option>Muscle Gain</option>
                  <option>Maintenance</option>
                  <option>Recomposition</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Current Weight (lbs)</label>
                <input type="number" step="0.1" defaultValue={progressData.currentWeight} className="w-full border border-gray-300 rounded-lg px-4 py-2" />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Target Weight (lbs)</label>
                <input type="number" step="0.1" defaultValue={progressData.targetWeight} className="w-full border border-gray-300 rounded-lg px-4 py-2" />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Height</label>
                <input type="text" defaultValue={userProfile.height} placeholder="e.g., 5'10\"" className="w-full border border-gray-300 rounded-lg px-4 py-2" />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Age</label>
                <input type="number" defaultValue={userProfile.age} className="w-full border border-gray-300 rounded-lg px-4 py-2" />
              </div>
              <button className="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 mt-6">
                Save Changes
              </button>
            </div>
          </div>
        )}
      </main>

      {showLogModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl max-w-md w-full max-h-[80vh] overflow-y-auto p-6">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-xl font-bold">Log Food</h3>
              <button onClick={closeModal}><X className="w-6 h-6" /></button>
            </div>
            {isAnalyzing && (
              <div className="flex flex-col items-center py-12">
                <Loader2 className="w-12 h-12 text-blue-600 animate-spin mb-4" />
                <p className="text-gray-600">{isRecording ? 'Listening...' : 'Analyzing...'}</p>
              </div>
            )}
            {analysisResult && !isAnalyzing && (
              <>
                {analysisResult.error ? (
                  <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                    <AlertCircle className="w-5 h-5 text-red-600 mb-2" />
                    <p className="text-sm text-red-800">{analysisResult.message}</p>
                  </div>
                ) : (
                  <>
                    {analysisResult.transcription && (
                      <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4">
                        <p className="text-sm"><strong>You said:</strong> "{analysisResult.transcription}"</p>
                      </div>
                    )}
                    <div className="border rounded-lg p-4 mb-4">
                      <h4 className="font-semibold mb-2">{analysisResult.name}</h4>
                      <div className="grid grid-cols-4 gap-2 text-center text-sm">
                        <div><div className="text-gray-600">Protein</div><div className="font-bold text-blue-600">{analysisResult.protein}g</div></div>
                        <div><div className="text-gray-600">Carbs</div><div className="font-bold text-green-600">{analysisResult.carbs}g</div></div>
                        <div><div className="text-gray-600">Fats</div><div className="font-bold text-yellow-600">{analysisResult.fats}g</div></div>
                        <div><div className="text-gray-600">Cal</div><div className="font-bold">{analysisResult.calories}</div></div>
                      </div>
                    </div>
                    <button onClick={() => { alert('Logged!'); closeModal(); }} className="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold">Log Food</button>
                  </>
                )}
              </>
            )}
          </div>
        </div>
      )}

      <nav className="fixed bottom-0 left-0 right-0 bg-white border-t">
        <div className="max-w-4xl mx-auto px-4 py-2 flex justify-around">
          <button onClick={() => setActiveTab('dashboard')} className={`flex flex-col items-center py-2 px-3 rounded-lg ${activeTab === 'dashboard' ? 'text-blue-600 bg-blue-50' : 'text-gray-600'}`}>
            <Utensils className="w-6 h-6" />
            <span className="text-xs font-medium">Plan</span>
          </button>
          <button onClick={() => setActiveTab('grocery')} className={`flex flex-col items-center py-2 px-3 rounded-lg ${activeTab === 'grocery' ? 'text-blue-600 bg-blue-50' : 'text-gray-600'}`}>
            <ShoppingCart className="w-6 h-6" />
            <span className="text-xs font-medium">Grocery</span>
          </button>
          <button onClick={() => setActiveTab('progress')} className={`flex flex-col items-center py-2 px-3 rounded-lg ${activeTab === 'progress' ? 'text-blue-600 bg-blue-50' : 'text-gray-600'}`}>
            <BarChart3 className="w-6 h-6" />
            <span className="text-xs font-medium">Progress</span>
          </button>
          <button onClick={() => setActiveTab('profile')} className={`flex flex-col items-center py-2 px-3 rounded-lg ${activeTab === 'profile' ? 'text-blue-600 bg-blue-50' : 'text-gray-600'}`}>
            <User className="w-6 h-6" />
            <span className="text-xs font-medium">Profile</span>
          </button>
        </div>
      </nav>
    </div>
  );
};

export default MacrolyFit;